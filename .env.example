# =============================================================================
# AJO Onchain — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit a real value.
# Nothing in this file is a secret as written — every value is a placeholder.
#
# Note which secrets are NOT here: there is no Stellar secret key for any
# backend service. The indexer holds no keys and signs nothing, and the web
# app signs with the user's wallet in the browser. If a future change seems to
# need a server-side signing key, read the header comment in
# apps/indexer/src/index.ts before adding one.
# =============================================================================

# --- Stellar network ---------------------------------------------------------
# Testnet values. For mainnet: https://mainnet.sorobanrpc.com and
# "Public Global Stellar Network ; September 2015".
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_NETWORK=testnet

# --- Deployed contracts ------------------------------------------------------
# Filled in by scripts/deploy-testnet.sh. The factory is the only address the
# indexer needs; it discovers vaults from the factory's `deployed` events.
FACTORY_CONTRACT_ID=
VAULT_WASM_HASH=

# Identity used by scripts/deploy-testnet.sh. This is the name of a key in the
# local Stellar CLI keystore (`stellar keys generate <name>`), not a secret.
# The secret stays in the keystore and never enters this file.
STELLAR_DEPLOY_IDENTITY=ajo-deployer

# --- Supabase (read cache) ---------------------------------------------------
# The cache the dashboard reads. If it is wrong or empty, the dashboard is
# wrong or empty; no funds are affected.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Indexer -----------------------------------------------------------------
INDEXER_POLL_INTERVAL_MS=5000

# --- Reminders (WhatsApp / SMS) ----------------------------------------------
# See apps/indexer/src/lib/reminders.ts. Business-initiated WhatsApp messages
# need a pre-approved template; start that approval early.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_FALLBACK_API_KEY=

# --- SEP-24 anchor (NGN <-> USDC) --------------------------------------------
# The anchor is outside the contract trust boundary — see audit/scope.md
# assumption 4. A dishonest anchor can fail to deliver naira; it cannot touch
# a circle's pot.
ANCHOR_HOME_DOMAIN=
ANCHOR_SEP24_TRANSFER_SERVER=

# --- Web app -----------------------------------------------------------------
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_FACTORY_CONTRACT_ID=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
