# --- Secrets ---
# .env.example is committed; nothing else in this family ever is.
.env
.env.*
!.env.example

# --- Rust / Soroban ---
contracts/target/
target/
**/*.rs.bk
*.wasm

# --- Node / Bun ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/

# --- Generated contract bindings ---
# Regenerated by `task bindings` from the deployed contracts. Committing them
# guarantees they will eventually disagree with the contracts they claim to
# describe.
packages/contract-bindings/src/
packages/contract-bindings/dist/

# --- Python (services/scoring, Tranche 3) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Editors and OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Local deployment output ---
.stellar/
deployments/*.json
!deployments/.gitkeep

# --- Internal planning material ---
